page {
  --bg: #f4f0e8;
  --card: #fffcf7;
  --ink: #2b2926;
  --muted: #8a847a;
  --line: #e7e1d6;
  --accent: #3f5b4d;
  --accent-soft: #e4eee8;
  --warm: #c45c26;
  --warm-soft: #f8ebe3;
  --danger: #a33b2b;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 100%;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 12rpx 8rpx 28rpx;
}

.kicker {
  color: var(--muted);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.section-title {
  margin: 12rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(64, 52, 32, 0.06);
}

.card + .card {
  margin-top: 20rpx;
}

.row {
  display: flex;
  align-items: center;
}

.space {
  justify-content: space-between;
}

.muted {
  color: var(--muted);
}

.btn {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
}

.btn-ghost {
  background: var(--accent-soft);
  color: var(--accent);
}

.btn-warm {
  background: var(--warm);
  color: #fff;
}

.btn-plain {
  background: transparent;
  color: var(--muted);
  font-weight: 400;
}

.btn[disabled] {
  opacity: 0.45;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--muted);
}

.empty-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.field {
  margin-bottom: 32rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.input,
.textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  background: #f7f3ec;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  font-size: 32rpx;
  line-height: 1.45;
  color: var(--ink);
  min-height: 96rpx;
}

.textarea {
  min-height: 180rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.input-placeholder,
.textarea-placeholder {
  color: #b0aaa0;
  font-size: 30rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f7f3ec;
  color: var(--muted);
  font-size: 24rpx;
}

.chip-on {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.metrics {
  display: flex;
  margin-top: 24rpx;
}

.metric {
  flex: 1;
}

.metric-n {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: var(--accent);
}

.metric-l {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
}

.tag-warm {
  background: var(--warm-soft);
  color: var(--warm);
}

.safe-tab {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
