<view class="heat">
  <view class="heat-top row space">
    <text class="heat-title">近 17 周完成日历</text>
    <text class="heat-sub">{{activeDays}} 天有记录</text>
  </view>

  <scroll-view scroll-x class="heat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="heat-board">
      <view class="month-row">
        <view class="weekday-spacer"></view>
        <view class="month-labels">
          <text class="month-label" wx:for="{{monthLabels}}" wx:key="index">{{item}}</text>
        </view>
      </view>
      <view class="grid-row">
        <view class="weekdays">
          <text class="weekday">日</text>
          <text class="weekday">一</text>
          <text class="weekday">二</text>
          <text class="weekday">三</text>
          <text class="weekday">四</text>
          <text class="weekday">五</text>
          <text class="weekday">六</text>
        </view>
        <view class="weeks">
          <view class="week" wx:for="{{weeks}}" wx:for-item="week" wx:key="index">
            <view
              class="day lv{{day.level}}"
              wx:for="{{week.days}}"
              wx:for-item="day"
              wx:key="date"
              data-date="{{day.date}}"
              data-count="{{day.count}}"
              bindtap="onDayTap"
            ></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="legend row space">
    <text class="tip">{{tip || '点格子可看当天情况'}}</text>
    <view class="legend-scale row">
      <text class="legend-text">少</text>
      <view class="day lv0"></view>
      <view class="day lv1"></view>
      <view class="day lv2"></view>
      <view class="day lv3"></view>
      <view class="day lv4"></view>
      <text class="legend-text">多</text>
    </view>
  </view>
</view>
